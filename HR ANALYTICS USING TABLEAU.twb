    <worksheet name='KPI'>
      <table>
        <view>
          <datasources>
            <datasource caption='HR data (HR Data)' name='federated.1vxc28p1kmc1r313cazjj0vb4ejt' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='bin size' datatype='real' name='[Parameter 1]' param-domain-type='range' role='measure' type='quantitative' value='2.'>
              <calculation class='tableau' formula='2.' />
              <range granularity='1.0' max='10.0' min='2.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1vxc28p1kmc1r313cazjj0vb4ejt'>
            <column caption='Age (bin)' datatype='integer' name='[Age (bin)]' role='dimension' type='ordinal'>
              <calculation class='bin' decimals='0' formula='[Age]' peg='0' size-parameter='[Parameters].[Parameter 1]' />
            </column>
            <column datatype='integer' name='[Age]' role='measure' type='quantitative' />
            <column datatype='string' name='[Attrition]' role='dimension' type='nominal' />
            <column caption='Attrition Count' datatype='integer' name='[Calculation_1104742547812352]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Attrition]=&quot;YES&quot; THEN 1&#13;&#10;ELSE 0 END' />
            </column>
            <column caption='Attrition Rate' datatype='real' name='[Calculation_1104742548885505]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1104742547812352])/SUM([Employee Count])' />
            </column>
            <column caption='Active Employess' datatype='integer' name='[Calculation_1104742549463042]' role='measure' type='ordinal'>
              <calculation class='tableau' formula='SUM([Employee Count])-SUM([Calculation_1104742547812352])' />
